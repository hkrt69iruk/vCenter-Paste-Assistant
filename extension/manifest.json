{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extensionName__",
  "version": "1.0.1",
  "description": "__MSG_extensionDescription__",
  "permissions": [
    "clipboardRead",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "vcenter-paste-assistant@hkrt69iruk.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vcenter-paste-i18n.js",
        "vcenter-paste-console.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/vcenter-paste-16.png",
    "48": "icons/vcenter-paste-48.png",
    "128": "icons/vcenter-paste-128.png"
  },
  "action": {
    "default_title": "__MSG_extensionActionTitle__",
    "default_icon": {
      "16": "icons/vcenter-paste-16.png",
      "48": "icons/vcenter-paste-48.png",
      "128": "icons/vcenter-paste-128.png"
    },
    "default_popup": "vcenter-paste-popup.html"
  },
  "options_ui": {
    "page": "vcenter-paste-options.html",
    "open_in_tab": true
  }
}
